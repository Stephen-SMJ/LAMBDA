# LAMBDA Local
LOCAL_MODE=true
DATABASE_URL=sqlite:///./data/lambda_local.db
FILE_STORAGE_MODE=local
CODE_EXECUTION_MODE=local
LOCAL_WORKSPACE_ROOT=./data/workspaces

# Security key used only for compatibility with existing auth utilities.
SECRET_KEY=change-this-local-secret
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=10080

# LLM configuration. Any OpenAI-compatible endpoint can be used.
OPENAI_API_KEY=your-api-key
OPENAI_BASE_URL=https://api.openai.com/v1
DEFAULT_MODEL=gpt-4o-mini

# Optional provider-specific keys.
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
XIAOMI_API_KEY=
XIAOMI_BASE_URL=https://token-plan-sgp.xiaomimimo.com/v1

# Local execution limits.
CODE_EXECUTION_TIMEOUT=900
MAX_OUTPUT_LENGTH=1000000

# Frontend dev server.
FRONTEND_URL=http://localhost:3000
